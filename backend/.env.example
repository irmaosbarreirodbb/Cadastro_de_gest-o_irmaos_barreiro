# Exemplo de Variáveis de Ambiente (Desenvolvimento e Produção / Railway)
DATABASE_URL=postgresql://postgres:senha@seu-host:5432/railway
SECRET_KEY=sua_chave_secreta_super_segura_de_producao_gerada_aleatoriamente
ENCRYPTION_KEY=sua_chave_fernet_super_segura_separada_da_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=production

# Alertas de exames toxicologicos via Brevo
BREVO_API_KEY=xkeysib-sua-chave-da-brevo
ALERT_EMAIL_TO=seu-email@empresa.com
ALERT_EMAIL_FROM=noreply@irmaosbarreiro.com.br
ALERT_EMAIL_FROM_NAME=Irmaos Barreiro - Alertas

# Origens permitidas pelo CORS (separadas por vírgula em produção)
ALLOWED_ORIGINS=https://seu-frontend.up.railway.app,https://seusite.com.br
